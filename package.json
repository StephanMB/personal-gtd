{
  "name": "personal-gtd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0"
  }
}
